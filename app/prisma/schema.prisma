generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum Workload {
  RED
  YELLOW
  GREEN
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  hashedPassword String
  role           Role       @default(USER)
  teamUsers      TeamUser[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Section {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  persons   Person[]
}

model Person {
  id          String       @id @default(cuid())
  firstName   String
  lastName    String
  section     Section      @relation(fields: [sectionId], references: [id])
  sectionId   String
  sdm         Person?      @relation("SdmRelation", fields: [sdmId], references: [id])
  sdmId       String?
  sdmOf       Person[]     @relation("SdmRelation")
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  assignments Assignment[]
  teamMembers TeamMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Project {
  id           String        @id @default(cuid())
  projectId    String        @unique
  name         String
  label        String?
  color        String?
  isActive     Boolean       @default(true)
  assignments  Assignment[]
  teamProjects TeamProject[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Assignment {
  id        String   @id @default(cuid())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  date      DateTime @db.Date
  isPrimary Boolean  @default(false)
  workload  Workload @default(YELLOW)

  @@unique([personId, projectId, date])
  @@index([personId, date])
}

model Team {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  members     TeamMember[]
  projects    TeamProject[]
  users       TeamUser[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TeamMember {
  id       String @id @default(cuid())
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId String

  @@unique([teamId, personId])
}

model TeamProject {
  id        String  @id @default(cuid())
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@unique([teamId, projectId])
}

model TeamUser {
  id     String @id @default(cuid())
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([teamId, userId])
}
